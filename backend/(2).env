# =============================================================================
# LocalMind backend configuration
# Rules for this file:
#   * One setting per line, KEY=value, no spaces around "=".
#   * Comments go on their own line, starting with "#".
#   * Every setting below is listed. A line starting with "#" is off and the
#     built-in default applies.
# =============================================================================


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# REQUIRED. The old key was shared in a chat, so generate a new one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Paste the output after the "=". The server refuses to start while this is
# empty. Changing it signs everyone out once; no data or passwords are lost.
DJANGO_SECRET_KEY=Qyz3ni4AgTihWGinKNiRMmPKCfP758kogmdvxFsvNRvZGTSDw9NIex7AUsf6TUsa

DJANGO_DEBUG=false

# * lets students on the LAN open http://<laptop-ip>:8000
DJANGO_ALLOWED_HOSTS=*

# Only needed for the Expo dev server (npx expo start). The built web client
# served by run_localmind.py is same-origin and does not use this.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082

# Only needed if the Django admin site sits behind an https proxy.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://localmind.example.edu

LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Absolute path, so every command finds the same database whatever folder it
# is run from. This is the same file the relative "sqlite:///db.sqlite3" used
# under run_localmind.py; check it exists before restarting.
DATABASE_URL=sqlite:///D:/Local_Mind_Integrated/backend/db.sqlite3
# DATABASE_URL=postgres://localmind:secret@localhost:5432/localmind

# How long a second writer waits for the SQLite lock before failing.
SQLITE_BUSY_TIMEOUT_SECONDS=30


# -----------------------------------------------------------------------------
# Files, uploads and the web client
# -----------------------------------------------------------------------------

# Absolute path to the uploaded books (same folder the old "./media" meant).
MEDIA_ROOT=D:/Local_Mind_Integrated/backend/media
MEDIA_URL=/media/
MAX_UPLOAD_MB=100

# Serve the built web client (frontend\dist) from this process.
SERVE_WEB=true
# Location of the built web client; the default is frontend\dist.
# WEB_DIST=D:\Local_Mind_Integrated\frontend\dist

# Has no effect while DJANGO_DEBUG=false; nothing in the app needs raw media URLs.
SERVE_MEDIA=true

# Process uploaded books inside the upload request instead of in the background.
# Leave false.
PROCESS_DOCUMENTS_INLINE=false

# A book still "processing" after this many minutes is treated as abandoned
# and may be processed again.
PROCESSING_STALE_MINUTES=30


# -----------------------------------------------------------------------------
# Accounts, sign-in and sessions
# -----------------------------------------------------------------------------

# shared: every new, imported and reset account starts on
# INITIAL_USER_PASSWORD and must change it at first login.
# unique: each account gets its own one-time password shown once to the admin.
INITIAL_PASSWORD_MODE=shared
INITIAL_USER_PASSWORD=LocalMind@123

# Wrong passwords allowed per account inside the window before that account
# is refused for the rest of the window. 0 turns the lockout off.
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
SESSION_HEARTBEAT_TIMEOUT_MINUTES=10

# Nothing sits in front of run_localmind.py, so no forwarded-for header is
# trusted. Set 1 only behind nginx or Caddy.
TRUSTED_PROXY_COUNT=0


# -----------------------------------------------------------------------------
# Security (applies because DJANGO_DEBUG=false)
# -----------------------------------------------------------------------------

# The laptop serves plain http on the LAN. Secure-only cookies would stop the
# Django admin site at /admin/ from signing in over http. The LocalMind app
# itself uses tokens, not cookies. Set both to true once served over https.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# No proxy in front, so a client-sent X-Forwarded-Proto must not be believed.
TRUST_PROXY_SSL_HEADER=false

SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# Live API schema and Swagger page at /api/schema/ and /api/docs/. Off in
# production; backend\openapi.yaml holds the same schema.
API_DOCS_ENABLED=false


# -----------------------------------------------------------------------------
# Learning rules
# -----------------------------------------------------------------------------

FACULTY_CAN_PUBLISH=true
DEFAULT_PASS_PERCENTAGE=65
MAX_QUIZ_DURATION_HOURS=6


# -----------------------------------------------------------------------------
# AI model (embedded, offline)
# -----------------------------------------------------------------------------

AI_ENABLED=true
AI_PROVIDER=llamacpp

# The model file lives in backend\models unless AI_MODEL_PATH is set.
AI_MODEL_FILE=Qwen3-1.7B-Q4_K_M.gguf
AI_MODEL_REPO=unsloth/Qwen3-1.7B-GGUF
# AI_MODEL_PATH=D:\models\Qwen3-1.7B-Q4_K_M.gguf

# Ryzen 7 7730U: 8 physical cores. All 16 logical threads is slower.
AI_THREADS=8
AI_BATCH=512
AI_GPU_LAYERS=0

# After a failed model load (for example out of memory), retry after this long.
AI_LOAD_RETRY_SECONDS=60

# Docling layout models for PDF parsing; the default is backend\models\docling.
# DOCLING_ARTIFACTS=D:\Local_Mind_Integrated\backend\models\docling

# Seconds to cache the AI readiness check used by the health page.
AI_HEALTH_CACHE_SECONDS=30


# -----------------------------------------------------------------------------
# AI performance and limits
# (the OLLAMA_ names apply to the embedded model too)
# -----------------------------------------------------------------------------

# fast: 8192 context, 8000 characters of source per prompt.
AI_PERFORMANCE_MODE=fast

# A tutor question or quiz waits up to this long for the model (for example
# while a background lesson finishes) instead of failing.
OLLAMA_TIMEOUT_SECONDS=300

# Absolute ceiling on generated tokens for any single call.
OLLAMA_NUM_PREDICT=4096

# One retry when the model's JSON is malformed or incomplete.
OLLAMA_MAX_RETRIES=1

# Shorter tutor answers. Other tasks use the fast profile:
# quiz 1400, lesson 1000, remediation 800, outline 800, evaluate 400,
# assignment 700, monitor 600.
AI_TUTOR_MAX_TOKENS=350

# Uncomment only to override the profile for one task.
# AI_QUIZ_MAX_TOKENS=1400
# AI_LESSON_MAX_TOKENS=1000
# AI_REMEDIATION_MAX_TOKENS=800
# AI_OUTLINE_MAX_TOKENS=800
# AI_EVALUATE_MAX_TOKENS=400
# AI_ASSIGNMENT_MAX_TOKENS=700
# AI_MONITOR_MAX_TOKENS=600

# Uncomment only to override the fast profile.
# OLLAMA_NUM_CTX=16384
# AI_MAX_SOURCE_CHARS=14000
# AI_MAX_CONVERSATION_MESSAGES=4
# AI_RETRIEVAL_CHUNKS=3


# -----------------------------------------------------------------------------
# Background lessons
# -----------------------------------------------------------------------------

# Queue a lesson for every module when a book is processed and whenever a
# module's text changes. false: lessons are made only when faculty press
# Generate Lessons.
LESSON_AUTO_GENERATE=true

# Retries when the model's output cannot be shaped into a lesson.
LESSON_MAX_ATTEMPTS=3

# Minutes before a failed lesson is tried again (doubles per attempt).
LESSON_RETRY_MINUTES=10

# A lesson still "generating" after this long is picked up again.
LESSON_STALE_MINUTES=15

# Seconds the idle lesson worker waits for new work before stopping.
LESSON_WORKER_IDLE_SECONDS=30


# -----------------------------------------------------------------------------
# Tidying new books
# -----------------------------------------------------------------------------

# Repair garbled heading titles and fold textbook boxes ("Questions",
# "Activity 5.3", "Do You Know?") and modules shorter than MIN_CHARS into the
# section they belong to. Books already uploaded: python manage.py tidy_book.
OUTLINE_MERGE_SMALL=true
OUTLINE_MERGE_MIN_CHARS=500
OUTLINE_MERGE_MAX_CHARS=16000


# -----------------------------------------------------------------------------
# Automatic module quizzes
# -----------------------------------------------------------------------------

# Write one quiz per module in the background, in turn with lessons. The AI
# monitor checks each one first; a quiz it flags as a serious problem is held
# as a draft for faculty review, the rest go live when their module is open.
AUTO_QUIZ_ENABLED=true

# Questions per automatic quiz. Open-ended questions are marked by the model
# when students submit, which is slow on this laptop, so they stay at 0.
AUTO_QUIZ_MCQS=5
AUTO_QUIZ_SUBJECTIVE=0
AUTO_QUIZ_PASS_PERCENTAGE=65
AUTO_QUIZ_MAX_ATTEMPTS=3

# Modules with less text than this (a "Questions" box, a bare heading) get no
# automatic quiz. 0 gives every module one.
AUTO_QUIZ_MIN_CHARS=500


# -----------------------------------------------------------------------------
# Ollama (ignored while AI_PROVIDER=llamacpp)
# -----------------------------------------------------------------------------

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TUTOR_MODEL=qwen3:1.7b
OLLAMA_OUTLINE_MODEL=qwen3:1.7b
OLLAMA_KEEP_ALIVE=30m


# -----------------------------------------------------------------------------
# AI Monitoring & Guard
# -----------------------------------------------------------------------------

AI_MONITOR_ENABLED=true
AI_MONITOR_MODE=async
AI_MONITOR_JUDGE_ENABLED=true

# Dedicated 7B judge model: OFF on this laptop. It loads a second ~5 GB model
# that runs at the same time as lessons and tutor answers, competes for the
# same 8 cores, and pauses the lesson queue for about 2 minutes per check.
# With these lines commented out the judge uses the shared 1.7B model
# (about 20 s per check). To turn the 7B judge back on, remove the "#".
# AI_MONITOR_MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
# AI_MONITOR_MODEL_REPO=bartowski/Qwen2.5-7B-Instruct-GGUF
# AI_MONITOR_MODEL_DOWNLOAD_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
# AI_MONITOR_MODEL_PATH=D:\models\judge.gguf
# AI_MONITOR_OLLAMA_MODEL=qwen2.5:7b-instruct

AI_MONITOR_SAMPLE_PERCENT=10
AI_MONITOR_MIN_JUDGE_CONFIDENCE=60
AI_MONITOR_MAX_EVIDENCE_CHARS=6000
AI_MONITOR_EVIDENCE_CHUNKS=4
AI_MONITOR_RETENTION_DAYS=180
AI_MONITOR_EVALUATOR_VERSION=1.1


# -----------------------------------------------------------------------------
# Offline model hub
# -----------------------------------------------------------------------------

# Stops Docling and the model loader from contacting Hugging Face once the
# models are in backend\models. Leave commented while running fetch_model.
# HF_HUB_OFFLINE=1

# -----------------------------------------------------------------------------
# Durable background jobs
# -----------------------------------------------------------------------------

DURABLE_JOBS=true
JOB_LEASE_SECONDS=300


# -----------------------------------------------------------------------------
# Private offline-study system
# -----------------------------------------------------------------------------

STUDY_SIGNING_KEY_PATH=D:/MindLocal_Secrets/publisher.pem
STUDY_SIGNING_KEY_ID=localmind-test-1

STUDY_OBSERVATIONS_ENABLED=false
STUDY_MIN_AGGREGATE_EVENTS=5


# -----------------------------------------------------------------------------
# Optional larger model for preparing study packages
# Leave these commented for now
# -----------------------------------------------------------------------------

# STUDY_AUTHOR_MODEL_PATH=D:/MindLocal_Models/author-model.gguf
# STUDY_AUTHOR_OLLAMA_MODEL=
# STUDY_AUTHOR_OLLAMA_URL=http://127.0.0.1:11434