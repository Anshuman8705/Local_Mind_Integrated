# Copy to .env (or export) before running. Never commit real values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://localmind:secret@localhost:5432/localmind

MEDIA_ROOT=./media
MEDIA_URL=/media/
MAX_UPLOAD_MB=100

# AI. Default provider "llamacpp" runs the model inside the app from a GGUF
# file (python manage.py fetch_model), fully offline, nothing to install.
# Set AI_PROVIDER=ollama to use a local Ollama daemon instead.
AI_ENABLED=true
AI_PROVIDER=llamacpp
# AI_MODEL_PATH=/absolute/path/to/model.gguf   (default: backend/models/AI_MODEL_FILE)
AI_MODEL_FILE=Qwen3-1.7B-Q4_K_M.gguf
AI_MODEL_REPO=unsloth/Qwen3-1.7B-GGUF
AI_THREADS=0
AI_GPU_LAYERS=0
# DOCLING_ARTIFACTS=/path/to/docling/models   (default: backend/models/docling)
# Serve the built web client and /media/ from Django (standalone, no nginx)
SERVE_WEB=true
SERVE_MEDIA=true
# Ollama settings (only when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TUTOR_MODEL=qwen3:1.7b
OLLAMA_OUTLINE_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_RETRIES=1
AI_MAX_SOURCE_CHARS=14000
AI_HEALTH_CACHE_SECONDS=30

# AI Monitoring & Guard (independent evaluation of every tutor answer and
# AI-generated quiz; see docs/AI_MONITORING.md). Validators always run; the
# judge model is only called for suspicious, undecided or sampled cases.
AI_MONITOR_ENABLED=true
AI_MONITOR_MODE=async
AI_MONITOR_JUDGE_ENABLED=true
# Dedicated judge model (optional). Empty = the judge shares the app model.
# AI_MONITOR_MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
# AI_MONITOR_MODEL_PATH=/absolute/path/to/judge.gguf
# AI_MONITOR_MODEL_REPO=bartowski/Qwen2.5-7B-Instruct-GGUF
# AI_MONITOR_MODEL_DOWNLOAD_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
# AI_MONITOR_OLLAMA_MODEL=qwen2.5:7b-instruct        (only when AI_PROVIDER=ollama)
AI_MONITOR_SAMPLE_PERCENT=10
AI_MONITOR_MIN_JUDGE_CONFIDENCE=60
AI_MONITOR_MAX_EVIDENCE_CHARS=6000
AI_MONITOR_EVIDENCE_CHUNKS=4
AI_MONITOR_RETENTION_DAYS=180
AI_MONITOR_EVALUATOR_VERSION=1.1

# The password every new account starts on, and which each user is forced to
# change at first login. CHANGE THIS before creating real accounts: the
# default is published in this repository's documentation.
INITIAL_USER_PASSWORD=change-me-before-creating-accounts
FACULTY_CAN_PUBLISH=true
SESSION_HEARTBEAT_TIMEOUT_MINUTES=10
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
