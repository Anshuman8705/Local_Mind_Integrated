# Production .env for LocalMind. Copy to backend/.env and review every line.
# Generated for this release; regenerate the key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=E7uCjMaU4BEUckmelFwXx7oYZgl1fg2iHCM9ViTmdUT7ti6JkagM7agwcbVlf7iT
DJANGO_DEBUG=false
# Add the server's hostname/IP. Use * only on a trusted local network.
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://localmind:secret@localhost:5432/localmind

MEDIA_ROOT=./media
MEDIA_URL=/media/
MAX_UPLOAD_MB=100

AI_ENABLED=true
AI_PROVIDER=llamacpp
AI_MODEL_FILE=Qwen3-1.7B-Q4_K_M.gguf
AI_MODEL_REPO=unsloth/Qwen3-1.7B-GGUF
# Physical cores, not logical threads. 0 = auto.
AI_THREADS=0
AI_BATCH=512
AI_GPU_LAYERS=0
SERVE_WEB=true
SERVE_MEDIA=true

# Applies to both providers despite the OLLAMA_ prefix.
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_PREDICT=4096
OLLAMA_MAX_RETRIES=1
AI_TUTOR_MAX_TOKENS=350
AI_HEALTH_CACHE_SECONDS=30

# Only used when AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TUTOR_MODEL=qwen3:1.7b
OLLAMA_OUTLINE_MODEL=qwen3:1.7b
OLLAMA_KEEP_ALIVE=30m

# AI Monitoring & Guard. See docs/AI_MONITORING.md.
AI_MONITOR_ENABLED=true
AI_MONITOR_MODE=async
AI_MONITOR_JUDGE_ENABLED=true
# Dedicated judge (4.7 GB download, ~5.5 GB RAM). Comment out to share the
# application model, which is the right choice under 16 GB of RAM.
# AI_MONITOR_MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
# AI_MONITOR_MODEL_REPO=bartowski/Qwen2.5-7B-Instruct-GGUF
# AI_MONITOR_MODEL_DOWNLOAD_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
AI_MONITOR_SAMPLE_PERCENT=10
AI_MONITOR_MIN_JUDGE_CONFIDENCE=60
AI_MONITOR_MAX_EVIDENCE_CHARS=6000
AI_MONITOR_EVIDENCE_CHUNKS=4
AI_MONITOR_RETENTION_DAYS=180
AI_MONITOR_EVALUATOR_VERSION=1.1

# CHANGE THIS before creating accounts.
INITIAL_USER_PASSWORD=change-me-before-creating-accounts
FACULTY_CAN_PUBLISH=true
SESSION_HEARTBEAT_TIMEOUT_MINUTES=10
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
